# === Secrets (never commit these) ===
# Everything under secrets/ is ignored except .gitkeep. The directory structure is kept
secrets/**
!secrets/**/
!secrets/**/.gitkeep
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
credentials.json
service-account*.json

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Editors ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Obsidian (prevents config noise/token leakage when opening notes/ as a vault) ===
# APP-1: see docs/decisions/2026-07-03-obsidian-context-stock.md
.obsidian/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === Node ===
node_modules/
.pnpm-store/
dist/
build/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Test / Coverage ===
coverage/
.nyc_output/
test-results/
playwright-report/
.test-logs/

# === The Context Funnel's staging area (raw, pre-inspection data. Phase 1 -> Phase 2 promotes it to a shelf) ===
# Where raw data received by /ingest-context sits until it's quarantined. Its contents are never committed.
definitions/.staging/

# === External SDK-derived artifacts (this template has no such dependency, but this guards against accidentally bringing them in) ===
# Prevents leftovers when bringing files in from a repo that used to depend on a heavyweight external SDK
.ccagi/
.pil-state/
.ai/

