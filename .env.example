# Alacrán reads no environment variables that it requires. Every variable
# below is optional; leave them commented out unless you need the override.
# Copy to .env.local (git-ignored) to use. Never commit real values.

# Where Alacrán keeps its own registry and settings. Default: a ".data" folder
# in development; ~/Library/Application Support/Alacrán on macOS and
# $XDG_DATA_HOME/Alacrán (else ~/.local/share/Alacrán) on Linux in a
# production build.
# ALACRAN_DATA_DIR=

# Set to 1 to skip the developer-only sample companies that otherwise load when
# their folders exist on your machine, to reproduce a true empty first run.
# ALACRAN_DISABLE_BUILTINS=1

# Set to any value to turn off the once-a-day update check in a production build.
# ALACRAN_NO_UPDATE_CHECK=1

# Path of the file where the app stores connector credentials you enter in
# its UI. Default: .env.local in the working directory.
# (FOUNDER_OS_ENV_LOCAL is a legacy alias for the same setting.)
# ALACRAN_ENV_LOCAL=

# Folder holding your global Claude skills. Default: ~/.claude/skills
# FOUNDER_OS_SKILLS_DIR=

# Markdown notes vault the Connected tools page looks for.
# Default: ~/Documents/Notes Vault
# OBSIDIAN_VAULT=

# Microsoft app registration to use for the Outlook sign-in instead of the
# built-in one, and where the Outlook sign-in is stored.
# Default store: ~/.config/alacran/outlook
# ALACRAN_OUTLOOK_CLIENT_ID=
# ALACRAN_OUTLOOK_HOME=

# Standard variables the app honours when set: Claude Code's config folder, and
# the Linux XDG data base directory (used to place the data folder above).
# CLAUDE_CONFIG_DIR=
# XDG_DATA_HOME=

# Release signing (maintainers and CI only; not needed to build or run the
# app). PEM contents of the private release-signing key, read by
# scripts/sign-release.mjs. Keep it in a CI secret or a keychain, never in this
# repository.
# ALACRAN_SIGNING_KEY=
